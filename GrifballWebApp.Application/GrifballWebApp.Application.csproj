<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The XML doc file, next to the server's assembly in every build and the Docker publish: Swagger's
         IncludeXmlComments (the server's Program.cs) reads it, so the DTOs' and enums' <summary> comments reach the
         OpenAPI document and the client generated from it. CS1591 (a public member without one) stays quiet: not
         every public type here needs one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- The use cases' internals, tested directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="GrifballWebApp.Application.Test" />
    <InternalsVisibleTo Include="GrifballWebApp.Integration.Test" />
  </ItemGroup>

  <!-- The use cases reach the models through Domain, and the database through IApplicationDbContext (EF Core comes with
       Domain). Nothing of Infrastructure or the web host: what is the outside world's is a port here, implemented there. -->
  <ItemGroup>
    <ProjectReference Include="..\GrifballWebApp.Domain\GrifballWebApp.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT: the schedule recommendations' genetic algorithm (Scheduler) -->
    <PackageReference Include="GeneticSharp" Version="3.1.4" />
    <!-- The chats (GrifChat): Microsoft.Extensions.AI and its tool calls, with no provider (IChatClientFactory's, in Infrastructure) -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <!-- The historical import's retries of the Halo pulls (the version Microsoft.Extensions.Http.Polly brings) -->
    <PackageReference Include="Polly" Version="7.2.4" />
    <!-- [TranspilationSource]: the hubs' DTOs, for the typed SignalR client (the server's Teams hub; grifballwebapp.client/src/generated/signalr) -->
    <PackageReference Include="Tapper.Attributes" Version="1.14.0" />
  </ItemGroup>

  <!-- What the web SDK's implicit usings gave these files in GrifballWebApp.Server -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
