<Project Sdk="Microsoft.NET.Sdk">

  <!-- GrifballWebApp.Infrastructure's types on their own, with test doubles: no real database server, no host, no
       containers, no network. A GrifballContext on in-memory or a temp-file SQLite is fine (approved 2026-11-12);
       a real server (Testcontainers, TestDatabase) is GrifballWebApp.Integration.Test's. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT: builds the xlsx fixtures the historical archive parsers read (HistoricalXlsx) -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp" Version="1.0.17">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GrifballWebApp.Infrastructure\GrifballWebApp.Infrastructure.csproj" />
    <!-- The domain tests' helpers (a test season, a season match in a state) -->
    <ProjectReference Include="..\GrifballWebApp.Domain.Test\GrifballWebApp.Domain.Test.csproj" />
  </ItemGroup>

  <!-- Its helpers (HistoricalXlsx, HistoricalTestData, TestCertificates) serve the integration tests too; its
       DatabaseProviderTestData (connection strings, Config) and DatabaseProviderMigrationsTestsBase/
       DesignTimeContextFactoryTestsBase serve the migrations projects' own Test, one subclass of each per provider -->
  <ItemGroup>
    <InternalsVisibleTo Include="GrifballWebApp.Integration.Test" />
    <InternalsVisibleTo Include="GrifballWebApp.Server.Test" />
    <InternalsVisibleTo Include="GrifballWebApp.Migrations.Postgres.Test" />
    <InternalsVisibleTo Include="GrifballWebApp.Migrations.Sqlite.Test" />
    <InternalsVisibleTo Include="GrifballWebApp.Migrations.SqlServer.Test" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="GrifballWebApp.Domain.Test" />
  </ItemGroup>

</Project>
