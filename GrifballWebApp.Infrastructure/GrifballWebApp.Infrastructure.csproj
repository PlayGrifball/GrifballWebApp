<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>06e01ca1-8eef-4f23-97c9-ea34879857e2</UserSecretsId>
  </PropertyGroup>

  <!-- The conversion's internals (Conversion), tested directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="GrifballWebApp.Infrastructure.Test" />
    <InternalsVisibleTo Include="GrifballWebApp.Integration.Test" />
  </ItemGroup>

  <!-- The models, their configurations and their loaders, and the ports of the use cases this project implements
       (IApplicationDbContext among them). -->
  <ItemGroup>
    <ProjectReference Include="..\GrifballWebApp.Application\GrifballWebApp.Application.csproj" />
    <ProjectReference Include="..\GrifballWebApp.Domain\GrifballWebApp.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <!-- The outside world's adapters (Halo Infinite, Discord, Redis, the xlsx reader, the database backups): ASP.NET Core's
       hosting, health checks and data protection, and the Discord client's interfaces. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\DiscordInterfaces\DiscordInterfaces.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT: reads the historical archive's xlsx snapshots (streaming, cached formula values) -->
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Surprenant.Grunt" Version="0.1.0" />
    <PackageReference Include="Surprenant.Grunt.Gateway.Client" Version="0.1.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
    <!-- The sheet export (Excel/ExcelService) -->
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.77.0.4309" />
    <!-- The Discord bot's chat model (Ollama/OllamaChatClients) -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="OllamaSharp" Version="5.5.0" />
    <!-- Apache-2.0: the background jobs, their schedules and history in the app database (GrifballWebApp.Infrastructure/Jobs) -->
    <PackageReference Include="Quartz.Extensions.Hosting" Version="4.6.2" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" Version="4.6.2" />
  </ItemGroup>

</Project>
