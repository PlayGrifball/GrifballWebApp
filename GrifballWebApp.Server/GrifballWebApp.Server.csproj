<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SpaRoot>..\grifballwebapp.client</SpaRoot>
    <SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:4200</SpaProxyServerUrl>
    <UserSecretsId>56909a5d-8f87-4041-a5f7-be52249ab0aa</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
    <!-- The XML doc file (next to the assembly, in every build and the Docker publish): Swagger's IncludeXmlComments
         reads it so actions' <summary>/<param>/<returns>/<remarks> reach the OpenAPI document. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment on a publicly visible member) would otherwise fire on every public type and
         member this project has, not just controller actions (DTOs, Program, helpers); that's not worth chasing
         everywhere, so it's a warning here, not an error - this project only, and it still isn't a SonarCloud
         rule (the error severities for the rules SonarCloud does raise live in the root .editorconfig). -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.Discord" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>10.0.14</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.14" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.28" />
    <PackageReference Include="AspNetCore.HealthChecks.System" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Common" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.19.1-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" Version="1.19.0-rc.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.20.1-beta.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <PackageReference Include="TypedSignalR.Client.DevTools" Version="1.2.4" />
    <PackageReference Include="TypedSignalR.Client.TypeScript.Attributes" Version="1.17.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="System.Linq.Async" Version="7.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- 
    Honestly not sure why there is a reference to the front end here...
    It is literally only causing problems in build process when using docker since we do not use the node image for the backend
    Almost tempted to just delete it but for now we will just not include it when building docker
    -->
    <ProjectReference Include="..\DiscordInterfaces\DiscordInterfaces.csproj" />
    <ProjectReference Include="..\grifballwebapp.client\grifballwebapp.client.esproj" Condition="!$(DefineConstants.Contains('DOCKER'))">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\GrifballWebApp.Application\GrifballWebApp.Application.csproj" />
    <ProjectReference Include="..\GrifballWebApp.Infrastructure\GrifballWebApp.Infrastructure.csproj" />
    <!-- Both providers' migrations: Database:Provider picks one at run time. -->
    <ProjectReference Include="..\GrifballWebApp.Migrations.Postgres\GrifballWebApp.Migrations.Postgres.csproj" />
    <ProjectReference Include="..\GrifballWebApp.Migrations.Sqlite\GrifballWebApp.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\GrifballWebApp.Migrations.SqlServer\GrifballWebApp.Migrations.SqlServer.csproj" />
  </ItemGroup>

  <!--
    GitInfo.CommitShortHash and GitInfo.CommitDate (the footer's BUILD, telemetry's service version), from git before
    each compile. Only the commit's own values, so the same commit compiles to the same bytes (docs/reproducible-builds.md):
    the package this replaces (Larcanum.GitInfo) wrote the time of the build into its generated file. Without git (a
    source archive), the hash is "unknown" and the date empty, which the footer leaves out (it can't read "unknown"
    as a date).
  -->
  <Target Name="WriteGitInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <Exec Command="git rev-parse --short=7 HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMsBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitShortHash" />
      <Output TaskParameter="ExitCode" PropertyName="_GitHashExitCode" />
    </Exec>
    <Exec Command="git show -s --format=%25cI HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMsBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitDate" />
      <Output TaskParameter="ExitCode" PropertyName="_GitDateExitCode" />
    </Exec>
    <PropertyGroup>
      <_GitCommitShortHash Condition="'$(_GitHashExitCode)' != '0'">unknown</_GitCommitShortHash>
      <_GitCommitDate Condition="'$(_GitDateExitCode)' != '0'"></_GitCommitDate>
      <_GitInfoFile>$(IntermediateOutputPath)GitInfo.g.cs</_GitInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_GitInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// &lt;auto-generated/&gt; by the WriteGitInfo target (GrifballWebApp.Server.csproj);namespace GrifballWebApp.Server%3B;internal static class GitInfo;{;    public const string CommitShortHash = &quot;$(_GitCommitShortHash)&quot;%3B;    public const string CommitDate = &quot;$(_GitCommitDate)&quot;%3B;}" />
    <ItemGroup>
      <Compile Include="$(_GitInfoFile)" />
      <FileWrites Include="$(_GitInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
