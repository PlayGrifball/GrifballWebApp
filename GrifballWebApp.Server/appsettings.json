{
  "ConnectionStrings": {
    "GrifballWebApp": "Server=localhost;Database=GrifballWebApp;Trusted_Connection=True;Encrypt=False;"
  },
  // Do not commit secrets to source control.
  //"Discord": {
  //  "ClientId": "", // For oauth
  //  "ClientSecret": "", // For oauth
  //  "Token": "YOUR_TOKEN_HERE", // Required if DisableGlobally is false
  //  "DraftChannel": 0, // Required if DisableGlobally is false
  //  "DisableGlobally": true // Optional parameter to disable sending discord notifications, defaults to false
  //},
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "GrifballWebApp": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Information",
        "NetCord": "Warning"
      }
    }
  },
  "HealthChecks": {
    // Endpoint paths (the frontend's nginx also serves them under /api).
    "Path": "/health",
    "LivePath": "/health/live",
    "ReadyPath": "/health/ready",
    // Managed memory above this reports Degraded. Size it below the container's memory limit.
    "MaxAllocatedMegabytes": 384,
    // The Halo Infinite API is called at most once per Interval, whatever polls /health.
    "HaloInfinite": {
      "Interval": "00:05:00",
      "Timeout": "00:00:10"
    }
  },
  "AllowedHosts": "*"
}
