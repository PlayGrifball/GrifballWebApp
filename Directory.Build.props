<Project>
  <!--
    SonarCloud's C# rules (csharpsquid) in every build: `dotnet build` reports what SonarCloud would, as warnings, so an
    issue shows up before the push. Warnings only: nothing here sets TreatWarningsAsErrors, and the existing issues are
    left to paydown PRs. Renovate keeps the version current; run .github/scripts/sonar-rules.sh after it changes.
  -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
  <!--
    The rules SonarCloud's quality profile turns on (Sonar way core), and the others off: the package alone turns on all
    of Sonar way. On test code SonarCloud raises only the test rules. An item's condition sees every property, the test
    SDK's IsTestProject included. The SonarCloud workflow's scanner (SonarQubeTempPath) brings the server's own rules.
  -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' And '$(SonarQubeTempPath)' == ''">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)analyzers/sonar-main.globalconfig" Condition="'$(IsTestProject)' != 'true'" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)analyzers/sonar-tests.globalconfig" Condition="'$(IsTestProject)' == 'true'" />
  </ItemGroup>
</Project>
