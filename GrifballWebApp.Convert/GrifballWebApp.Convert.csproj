<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
  </ItemGroup>

  <!-- Both migrations assemblies: the target is migrated with its server's. -->
  <ItemGroup>
    <ProjectReference Include="..\GrifballWebApp.Infrastructure\GrifballWebApp.Infrastructure.csproj" />
    <ProjectReference Include="..\GrifballWebApp.Migrations.Postgres\GrifballWebApp.Migrations.Postgres.csproj" />
    <ProjectReference Include="..\GrifballWebApp.Migrations.Sqlite\GrifballWebApp.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\GrifballWebApp.Migrations.SqlServer\GrifballWebApp.Migrations.SqlServer.csproj" />
  </ItemGroup>

  <!-- The unit tests give RunAsync their own conversion (DatabaseConverter is sealed and needs real databases); the
       integration tests give it a real one they stop partway -->
  <ItemGroup>
    <InternalsVisibleTo Include="GrifballWebApp.Convert.Test" />
    <InternalsVisibleTo Include="GrifballWebApp.Integration.Test" />
  </ItemGroup>

</Project>
