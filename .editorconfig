# Analyzer rules SonarCloud raised and the Sonar paydown took to zero: errors here, so the build keeps them at zero.
# These settings win over the generated analyzers/*.globalconfig (sonar-rules.sh). Nothing else (formatting, style)
# is set here. EF's migrations are generated code, which analyzers skip.
root = true

[*.cs]
# NUnit: Assert.EnterMultipleScope over Assert.Multiple
dotnet_diagnostic.NUnit2056.severity = error
# NUnit: independent asserts in one multiple scope
dotnet_diagnostic.NUnit2045.severity = error
# CA1861: constant arrays as arguments are static readonly fields
dotnet_diagnostic.CA1861.severity = error
# NUnit: the specific constraint (Is.Null, Is.Zero, Is.Default ...)
dotnet_diagnostic.NUnit4002.severity = error
# NUnit: Has.Length/Has.Count, Is.EqualTo and Does.Contain over comparisons in the actual value; no actual that is its own expected; comparable values only; only tests public in a fixture
dotnet_diagnostic.NUnit2046.severity = error
dotnet_diagnostic.NUnit2010.severity = error
dotnet_diagnostic.NUnit2014.severity = error
dotnet_diagnostic.NUnit2009.severity = error
dotnet_diagnostic.NUnit2042.severity = error
dotnet_diagnostic.NUnit1028.severity = error

# EF's migrations: generated code (SonarCloud doesn't analyse them either)
[GrifballWebApp.Migrations.*/Migrations/**.cs]
generated_code = true
